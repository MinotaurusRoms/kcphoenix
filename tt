    <div class="order-section">
        <h2>Deine Auswahlliste</h2>
        <div id="cart-container" class="table-responsive">
            <p class="cart-empty-msg">Noch keine Artikel ausgewählt.</p>
        </div>

        <div class="member-info">
            <div class="form-group">
                <label for="member-name">Dein vollständiger Name *</label>
                <input type="text" id="member-name" placeholder="Vorname Nachname" required>
            </div>
            <div class="form-group">
                <label for="member-group">Abteilung / Gruppe *</label>
                <input type="text" id="member-group" placeholder="z. B. Tanzgarde, Elferrat" required>
            </div>
        </div>

        <button type="button" class="btn-submit" onclick="sendOrder()">Bestellung abschließen</button>
    </div>

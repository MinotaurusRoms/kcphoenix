    <title>Vereinskleidung - K.C.Phoenix</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: #000000;
            color: #ffffff;
            width: 100%;
            overflow-x: hidden;
        }
        header {
            background: #111;
            color: white;
            padding: 15px 10px;
            text-align: center;
            position: sticky;
            top: 0;
            z-index: 100;
            box-shadow: 0 4px 10px rgba(0,0,0,0.5);
            border-bottom: 1px solid #222;
        }
        header h1 {
            font-size: 1.5rem;
            letter-spacing: 1px;
            text-transform: uppercase;
        }
        header p {
            font-size: 0.85rem;
            color: #ccc;
            margin-top: 5px;
        }
        .container {
            width: 100%;
            max-width: 1200px;
            margin: 15px auto;
            padding: 0 10px;
        }
        .intro {
            background: #161616;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            border-left: 4px solid #e44d26;
            font-size: 0.9rem;
            line-height: 1.5;
        }
        .intro h2 {
            margin-bottom: 8px;
            font-size: 1.2rem;
            color: #ffffff;
        }
        .checkbox-container {
            display: flex;
            align-items: center;
            margin-top: 15px;
            padding-top: 12px;
            border-top: 1px solid #2a2a2a;
            cursor: pointer;
            font-weight: bold;
            color: #ffffff;
            font-size: 0.95rem;
        }
        .checkbox-container input {
            margin-right: 10px;
            width: 20px;
            height: 20px;
            accent-color: #e44d26;
            cursor: pointer;
        }
        
        /* Neue Styling-Klasse für die Abholort-Infobox im Google-Stil */
        .pickup-info-card {
            background: #1c1c1c;
            border: 1px solid #333;
            border-radius: 8px;
            padding: 15px;
            margin-bottom: 20px;
            box-shadow: 0 4px 6px rgba(0,0,0,0.2);
        }
        .pickup-info-card h3 {
            font-size: 1.15rem;
            color: #e44d26;
            margin-bottom: 10px;
            border-bottom: 1px solid #2a2a2a;
            padding-bottom: 5px;
        }
        .pickup-details {
            font-size: 0.85rem;
            line-height: 1.4;
            color: #dddddd;
        }
        .pickup-details p {
            margin-bottom: 6px;
        }
        .pickup-details strong {
            color: #ffffff;
        }
        .opening-hours {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px dashed #2a2a2a;
        }
        .opening-hours table {
            width: 100%;
            max-width: 300px;
            font-size: 0.8rem;
            color: #ccc;
        }
        .opening-hours td {
            padding: 2px 0;
        }
        .opening-hours td:last-child {
            text-align: right;
            font-weight: bold;
            color: #ffffff;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .product-card {
            background: #161616;
            border: 1px solid #2a2a2a;
            padding: 15px;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
            width: 100%;
        }
        .product-images {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 15px;
            flex-wrap: nowrap; /* verhindert Umbruch */
        }
        
        .img-container {
            flex: 1;
            max-width: 250px;
            height: 300px;
            position: relative;
            background: #222;
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #333;
        }
        
        .img-container img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
        .img-label {
            position: absolute;
            bottom: 5px;
            left: 5px;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 2px 6px;
            font-size: 0.7rem;
            border-radius: 3px;
            font-weight: bold;
        }
        .product-title {
            font-size: 1.1rem;
            margin-bottom: 4px;
            color: #ffffff;
        }
        .product-price-tag {
            font-size: 1.1rem;
            font-weight: bold;
            color: #e44d26;
            margin-bottom: 8px;
        }
        .product-details {
            font-size: 0.85rem;
            color: #bbbbbb;
            margin-bottom: 15px;
            line-height: 1.4;
        }
        .form-group {
            margin-bottom: 10px;
        }
        .form-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: bold;
            margin-bottom: 4px;
            color: #cccccc;
        }
        .form-group select, .form-group input {
            width: 100%;
            padding: 8px;
            border: 1px solid #444;
            border-radius: 4px;
            background: #222;
            color: #ffffff;
            font-size: 0.9rem;
        }
        .form-group select:focus, .form-group input:focus {
            outline: none;
            border-color: #e44d26;
        }
        .btn-add {
            background: #ffffff;
            color: #000000;
            border: none;
            padding: 10px;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            font-size: 0.9rem;
            font-weight: bold;
            margin-top: 5px;
            transition: background 0.2s, opacity 0.2s;
        }
        .btn-add:disabled {
            background: #444444;
            color: #888888;
            cursor: not-allowed;
            opacity: 0.6;
        }
        .order-section {
            background: #161616;
            border: 1px solid #2a2a2a;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.4);
            width: 100%;
        }
        .order-section h2 {
            margin-bottom: 15px;
            border-bottom: 2px solid #ffffff;
            padding-bottom: 5px;
            font-size: 1.2rem;
            color: #ffffff;
        }
        .cart-empty-msg {
            color: #888888;
            font-style: italic;
            text-align: center;
            padding: 15px 0;
            font-size: 0.9rem;
        }
        .table-responsive {
            width: 100%;
        }
        .cart-table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 15px;
            font-size: 0.85rem;
            color: #ffffff;
        }
        .cart-table th, .cart-table td {
            padding: 8px 4px;
            text-align: left;
            border-bottom: 1px solid #2a2a2a;
        }
        .cart-table th {
            background: #222222;
            font-weight: bold;
            color: #ffffff;
        }
        .cart-total-row {
            background: #25120e;
            font-weight: bold;
            font-size: 0.95rem;
        }
        .cart-total-row td {
            border-top: 2px solid #e44d26;
            border-bottom: 2px solid #e44d26 !important;
            padding: 12px 4px;
            color: #ffffff;
        }
        .desktop-only {
            display: table-cell;
        }
        .btn-remove {
            background: #ff4d4d;
            color: white;
            border: none;
            padding: 4px 8px;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.75rem;
        }
        .member-info {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 15px;
            margin-bottom: 15px;
        }
        .btn-submit {
            background: #e44d26;
            color: white;
            border: none;
            padding: 14px 20px;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
            font-size: 1.1rem;
            font-weight: bold;
            margin-top: 5px;
            box-shadow: 0 3px 6px rgba(228,77,38,0.4);
        }

        @media (max-width: 480px) {
            header h1 { font-size: 1.3rem; }
            .product-images { flex-direction: column; gap: 8px; }
            .img-container { aspect-ratio: 16 / 9; }
            .member-info { grid-template-columns: 1fr; }
            .desktop-only { display: none; }
            .cart-table thead { display: none; }
            .cart-table, .cart-table tbody { display: block; width: 100%; }
            .cart-table tr { display: block; margin-bottom: 12px; border: 1px solid #2a2a2a; padding: 10px; border-radius: 6px; background: #1c1c1c; width: 100%; }
            .cart-table td { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; border: none; width: 100%; font-size: 0.9rem; }
            .cart-table td::before { content: attr(data-label); font-weight: bold; color: #aaa; padding-right: 10px; }
            .cart-table .cart-total-row { border: 2px solid #e44d26; background: #25120e; margin-top: 15px; }
            .cart-table .cart-total-row td { justify-content: space-between; font-size: 1rem; padding: 8px 4px; }
            .cart-table td:last-child { justify-content: center; margin-top: 8px; border-top: 1px dashed #333; padding-top: 10px; }
        }

<script>
    const PRODUCT_PRICES = {
        'p1': 28.20, 'p2': 18.50, 'p3': 29.00, 'p4': 21.00, 'p5': 19.00, 'p6': 19.50,
        'p7': 18.50, 'p8': 21.00, 'p9': 28.00, 'p10': 29.00, 'p11': 19.50, 'p12': 16.50
    };

    let cart = [];

    function formatCurrency(amount) {
        return amount.toFixed(2).replace('.', ',') + ' EUR';
    }

    function initPrices() {
        for (const [id, price] of Object.entries(PRODUCT_PRICES)) {
            const priceTag = document.getElementById(`price-${id}`);
            if (priceTag) {
                priceTag.textContent = formatCurrency(price);
            }
        }
    }

    function validateCard(cardId) {
        const card = document.getElementById(cardId);
        const sizeEl = card.querySelector('.prod-size');
        const qtyEl = card.querySelector('.prod-qty');
        const btn = document.getElementById(`btn-${cardId}`);
        
        let isSizeValid = true;
        if (sizeEl) {
            isSizeValid = sizeEl.value !== "";
        }
        
        const qtyValue = parseInt(qtyEl.value);
        let isQtyValid = !isNaN(qtyValue) && qtyValue >= 1;
        
        if (isSizeValid && isQtyValid) {
            btn.removeAttribute('disabled');
        } else {
            btn.setAttribute('disabled', 'true');
        }
    }

    function addItem(title, cardId) {
        const card = document.getElementById(cardId);
        
        const sizeEl = card.querySelector('.prod-size');
        const frontInput = card.querySelector('.prod-custom-front');
        const backInput = card.querySelector('.prod-custom-back');
        const qtyEl = card.querySelector('.prod-qty');
        
        const size = sizeEl ? sizeEl.value : 'Einheitsgröße';
        const customFront = frontInput ? (frontInput.value.trim() || 'Nein') : 'Nicht möglich';
        const customBack = backInput ? (backInput.value.trim() || 'Nein') : 'Nicht möglich';
        
        const qty = parseInt(qtyEl.value) || 0;
        const singlePrice = PRODUCT_PRICES[cardId] || 0;

        if (qty < 1) return;

        cart.push({
            title: title,
            size: size,
            customFront: customFront,
            customBack: customBack,
            qty: qty,
            singlePrice: singlePrice,
            totalPrice: singlePrice * qty
        });

        if (sizeEl) sizeEl.value = "";
        if (frontInput) frontInput.value = 'Tanzgarde';
        if (backInput) backInput.value = 'Tanzgarde';
        qtyEl.value = "";
        
        document.getElementById(`btn-${cardId}`).setAttribute('disabled', 'true');

        updateCartUI();
    }

    function removeItem(index) {
        cart.splice(index, 1);
        updateCartUI();
    }

    function updateCartUI() {
        const container = document.getElementById('cart-container');
        if (cart.length === 0) {
            container.innerHTML = '<p class="cart-empty-msg">Noch keine Artikel ausgewählt.</p>';
            return;
        }

        let totalCartPrice = 0;
        let html = `<table class="cart-table">
            <thead>
                <tr>
                    <th>Artikel</th>
                    <th>Größe</th>
                    <th>Druck V.</th>
                    <th>Druck H.</th>
                    <th>Anzahl</th>
                    <th>Gesamt</th>
                    <th>Aktion</th>
                </tr>
            </thead>
            <tbody>`;

        cart.forEach((item, index) => {
            totalCartPrice += item.totalPrice;
            html += `<tr>
                <td data-label="Artikel">${item.title}</td>
                <td data-label="Größe">${item.size}</td>
                <td data-label="Druck V.">${item.customFront}</td>
                <td data-label="Druck H.">${item.customBack}</td>
                <td data-label="Anzahl">${item.qty}x</td>
                <td data-label="Gesamt">${formatCurrency(item.totalPrice)}</td>
                <td><button class="btn-remove" onclick="removeItem(${index})">Löschen</button></td>
            </tr>`;
        });

        html += `<tr class="cart-total-row">
            <td colspan="4" class="desktop-only">GESAMTSUMME:</td>
            <td data-label="Gesamtsumme" class="desktop-only"></td>
            <td data-label="Gesamtsumme">${formatCurrency(totalCartPrice)}</td>
            <td></td>
        </tr>
        </tbody></table>`;

        container.innerHTML = html;
    }

    function sendOrder() {
        const termsCheckbox = document.getElementById('accept-terms');
        const nameInput = document.getElementById('member-name');
        const groupInput = document.getElementById('member-group');

        // 1. Validierung: Checkbox MUSS aktiv sein
        if (!termsCheckbox || !termsCheckbox.checked) {
            alert('Bitte bestätige zuerst den Informationstext („Gelesen und akzeptiert“), um fortzufahren.');
            if(termsCheckbox) termsCheckbox.focus();
            return;
        }

        // 2. Validierung: Name ausgefüllt?
        if (!nameInput.value.trim()) {
            alert('Bitte gib deinen vollständigen Namen ein.');
            nameInput.focus();
            return;
        }

        // 3. Validierung: Gruppe ausgefüllt?
        if (!groupInput.value.trim()) {
            alert('Bitte gib deine Abteilung / Gruppe ein.');
            groupInput.focus();
            return;
        }

        // 4. Validierung: Warenkorb nicht leer?
        if (cart.length === 0) {
            alert('Deine Auswahlliste ist leer. Bitte füge zuerst Artikel hinzu.');
            return;
        }

        const name = nameInput.value.trim();
        const group = groupInput.value.trim();

        let emailBody = `Bestellung Vereinsbekleidung - K.C.Phoenix\n`;
        emailBody += `==========================================\n\n`;
        emailBody += `Name: ${name}\n`;
        emailBody += `Abteilung/Gruppe: ${group}\n`;
        emailBody += `Abholort: Basilika Textildruck, Casterfeldstraße 74-76, 68199 Mannheim\n\n`;
        emailBody += `Bestellte Artikel:\n`;
        emailBody += `------------------------------------------\n`;

        let total = 0;
        cart.forEach((item, i) => {
            total += item.totalPrice;
            emailBody += `${i + 1}. ${item.qty}x ${item.title}\n`;
            emailBody += `   Größe: ${item.size}\n`;
            emailBody += `   Druck Vorne: ${item.customFront}\n`;
            emailBody += `   Druck Hinten: ${item.customBack}\n`;
            emailBody += `   Preis: ${formatCurrency(item.totalPrice)}\n\n`;
        });

        emailBody += `------------------------------------------\n`;
        emailBody += `Gesamtsumme: ${formatCurrency(total)}

`;
        emailBody += `Bitte die Bestellung prüfen und an den Lieferanten weiterleiten.`;

        const subject = `Bestellung Vereinskleidung - ${name}`;
        const mailtoUrl = `mailto:info@phoenix-schwetzingen.de?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(emailBody)}`;

        window.location.href = mailtoUrl;
    }

    window.onload = initPrices;
</script>
